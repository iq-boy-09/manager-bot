BOT_TOKEN=123456789:replace-with-your-bot-token
OWNER_ID=123456789
DATABASE_PATH=f4manager.db
TIMEZONE=Asia/Kolkata

# Optional limits
MAX_CHANNELS_FREE=2
MAX_SCHEDULES_FREE=5
MAX_RULES_FREE=2
MAX_BUTTONS_FREE=5
MAX_CHANNELS_PAID=25
MAX_SCHEDULES_PAID=200
MAX_RULES_PAID=50
MAX_BUTTONS_PAID=20

# Optional premium/payment settings
CURRENCY_SYMBOL=₹
PREMIUM_PRICE=39
PREMIUM_DAYS=30
PAYMENT_UPI_ID=
PAYMENT_UPI_NAME=
PAYMENT_INSTRUCTIONS=1. Open your UPI app.\n2. Pay ₹39 to {upi_id} ({upi_name}).\n3. Copy the Transaction ID (UTR), or take a screenshot of the successful payment.\n4. Return here and paste the UTR or send the screenshot below.\n\nYour payment will be reviewed by the owner.

# Optional operations
MAINTENANCE_MODE=false
LOG_LEVEL=INFO
